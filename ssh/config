Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/<YOUR_GITHUB_KEY>
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes

Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/<YOUR_SECOND_GITHUB_KEY>
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
